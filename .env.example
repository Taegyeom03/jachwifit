# 이 파일을 복사해 .env.local을 만들고 값을 채운다 (.env.local은 git에 올라가지 않음)

# 계정 연동 (Supabase → Project Settings → API). 비워 두면 로그인 없이 이 기기에만 저장된다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 문장으로 기록(AI) · 서버에서만 씀. NEXT_PUBLIC_을 붙이지 않는다 (README 7.6.1)
OPENROUTER_API_KEY=
# 선택: 모델(기본 anthropic/claude-haiku-5.5), 하루 사용자당 호출 수(기본 20)
OPENROUTER_MODEL=
AI_DAILY_LIMIT=

# 음식 데이터 갱신 스크립트용 (앱 실행에는 필요 없음)
DATA_GO_KR_KEY=
